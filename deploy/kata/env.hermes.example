# Railway service: hermes-day. This file reserves only what W10 (the
# CopilotKit popup) adds; the full hermes-day variable set (MODAL_*,
# OPENROUTER_API_KEY, LEARNING_SERVICE_*, messaging-platform tokens) is D1's
# own reservation (KATA-12).

# Bearer token the `web` service's CopilotKit runtime authenticates with —
# same value as `web`'s HERMES_API_KEY (env.web.example). Required: Hermes
# refuses to start its api_server platform without it.
API_SERVER_KEY=

# Optional — gateway/platforms/api_server.py defaults: port 8000, CORS open.
API_SERVER_PORT=8000
API_SERVER_CORS_ORIGINS=   # WEB_BASE_URL only — no other origin may call this platform directly
