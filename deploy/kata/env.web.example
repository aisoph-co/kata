# Railway service: web. This file reserves only what W10 (the CopilotKit
# popup) adds; the full `web` service variable set (Auth0, SESSION_SECRET,
# LEARNING_SERVICE_URL, ...) is tracked in the ops repo
# (agents-everywhere-hackathon `deploy/kata/env.web.example`, D1/KATA-12).

# The self-hosted CopilotKit runtime (`web/server`) forwards every popup
# turn to Hermes's api_server platform. HERMES_API_URL must include Hermes's
# API version prefix (e.g. https://hermes-day.example.com/v1) — the OpenAI
# SDK appends /chat/completions itself.
HERMES_API_URL=
HERMES_API_KEY=          # same value as hermes-day's API_SERVER_KEY

# Port the runtime's plain Node HTTP server listens on.
COPILOT_RUNTIME_PORT=8090

# Verifying the browser's Auth0 ID token server-side. W1 already configures
# a tenant client-side as VITE_AUTH0_DOMAIN / VITE_AUTH0_CLIENT_ID; these are
# the same values, reserved again under non-VITE_ names because VITE_-
# prefixed vars are inlined into the client bundle at build time and are not
# readable by this server process at runtime.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Reused from W1/Caddy's own e2e bypass (AGCTM-64, finding #5) — same name,
# same value as this service's existing E2E_AUTH_BYPASS_TOKEN, never a
# second bypass secret. Unset in every non-test deployment.
E2E_AUTH_BYPASS_TOKEN=

# CORS: the runtime only ever expects the deployed SPA as a caller.
WEB_BASE_URL=
