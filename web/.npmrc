# @copilotkit/runtime's transitive optional peers (channels-intelligence ->
# vitest, among others) crash npm 10's modern peer resolver with "Cannot
# read properties of null (reading 'edgesOut')" — a known @npmcli/arborist
# bug, not a real conflict with anything in this project. legacy-peer-deps
# routes around it the same way for `npm install` here and in CI.
legacy-peer-deps=true
