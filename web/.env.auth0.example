# AE-24: run the sign-in gate locally without touching the default .env
# (which every other walkthrough relies on staying unset).
#
#   cp .env.auth0.example .env.auth0.local
#   # fill in the two values below (ask the tenant owner)
#   npm run dev:auth0
#
# .env.auth0.local is gitignored (matches .env.*) — real values never land
# in the repo. Vite loads it on top of .env for `--mode auth0` only.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
