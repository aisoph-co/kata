# Auth0 tenant for Screen 1 (web sign-in). Unset (as in every environment
# today, per BRIEF.md "empty at 11:30") -> AUTH_ENABLED is false and the
# sign-in gate is a no-op passthrough, exactly like it is with these unset.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Dev-server only (never sent to the browser, see vite.config.ts): the /api
# proxy's bearer token and upstream, mirroring the Caddyfile's prod values.
WEB_SERVICE_TOKEN=dev
LEARNING_SERVICE_URL=http://localhost:8000

# e2e bypass (finding #5, AGCTM-64). Unset = /__e2e/session is a 404 = no
# bypass, for every deployment that doesn't set this.
E2E_AUTH_BYPASS_TOKEN=
