SERVICE_TOKEN=dev
API_TARGET=http://localhost:8000

# Sign-in gate (AE-24) — left unset here on purpose: the persona-switcher
# demo mode must keep working with no Auth0 tenant
# configured. To run the gate locally instead, see .env.auth0.example
# (`npm run dev:auth0`) rather than setting these here.

# Sign-in gate kill switch (KATA-28) — off by default. A deployment that
# does have VITE_AUTH0_DOMAIN/VITE_AUTH0_CLIENT_ID set can still set this to
# `true` to force the gate off, e.g. for a public demo. Reads are the only
# thing that unlocks (mock seeded data); the backend still gates writes on
# its own service token regardless of this flag.
# VITE_AUTH0_DISABLED=

# e2e auth bypass (AGCTM-64 finding #5) — unset everywhere but a test
# deployment. When set, `/__e2e/session` lets a browser that sends the same
# value in `X-E2E-Auth-Bypass` act as the seed learner named in
# `X-E2E-Learner-Email`, skipping Auth0. Unset, that route is a 404 and
# sign-in is untouched.
# E2E_AUTH_BYPASS_TOKEN=

# Kata bot in the web app (W10, KATA-14) — the absolute URL of the
# CopilotKit runtime (`npm run server:start`, default :8090/copilotkit).
# Vite inlines it at build time; unset (the default) means no popup at all,
# which is what every deployment without a provisioned runtime wants.
# VITE_COPILOTKIT_RUNTIME_URL=http://localhost:8090/copilotkit

# Kata bot on/off switch (KATA-28) — on by default (unset, or anything but
# the literal string `false`). Set to `false` to hide the popup even in a
# deployment that has VITE_COPILOTKIT_RUNTIME_URL configured.
# VITE_COPILOTKIT_ENABLED=
