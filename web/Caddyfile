# PLAN_10: serves the built SPA and proxies /api/* to the learning service,
# injecting the service token server-side so it never reaches the browser.
{
	admin off
}

:{$PORT:8080} {
	encode gzip

	# Container/Railway health probe.
	handle /healthz {
		respond "ok" 200
	}

	# AGCTM-64 finding #5: e2e auth bypass. The SPA asks this once at
	# load (SessionGate) and, on a 200, acts as the named seed learner
	# instead of going through Auth0. Granted only when the service has
	# E2E_AUTH_BYPASS_TOKEN set AND the request carries that exact value —
	# variable unset (every non-test deployment) means this is a 404 for
	# everyone, so Screen 1 is exactly as strict as it was.
	handle /__e2e/session {
		@bypass expression `{env.E2E_AUTH_BYPASS_TOKEN} != "" && {header.X-E2E-Auth-Bypass} == {env.E2E_AUTH_BYPASS_TOKEN} && {header.X-E2E-Learner-Email} != ""`
		handle @bypass {
			header Content-Type application/json
			respond `{"email":"{header.X-E2E-Learner-Email}"}` 200
		}
		respond 404
	}

	# Strip /api, forward to the learning service, and replace whatever
	# Authorization header the client sent (if any) with the real bearer
	# token — client-supplied credentials never reach the upstream. The
	# e2e bypass headers stop here too; the core never sees them.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$LEARNING_SERVICE_URL} {
			header_up Authorization "Bearer {$LEARNING_SERVICE_TOKEN}"
			header_up -X-E2E-Auth-Bypass
			header_up -X-E2E-Learner-Email
		}
	}

	# KATA-14 (demo round): the popup's CopilotKit runtime, co-located in
	# this same container (docker-entrypoint.sh) and reachable only through
	# this proxy — never a public port of its own. Headers pass through
	# unmodified: unlike /api/*, the runtime does its own identity
	# resolution (Auth0 ID token or the e2e bypass pair) and needs the
	# original Authorization/X-E2E-* headers, not a substituted one.
	handle /copilotkit {
		reverse_proxy localhost:{$COPILOT_RUNTIME_PORT:8090}
	}

	# Static assets + SPA fallback (client-side router owns every other path).
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
